{
  "name": "@eft/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "db:local": "pglite-server --db=.pglite --host=127.0.0.1 --port=5432 --max-connections=10",
    "start:local": "node --env-file=../../.env dist/main.js",
    "db:migrate:local": "node --env-file=../../.env dist/db/migrate.js"
  },
  "dependencies": {
    "@eft/contracts": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "0.2.11",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.3"
  }
}
