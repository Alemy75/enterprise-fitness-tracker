{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "db",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@eft/api", "db:local"],
      "port": 5432
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@eft/api", "start:local"],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@eft/web", "dev"],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    }
  ]
}
